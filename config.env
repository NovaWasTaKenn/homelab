
DOMAIN=pve.local
PROXMOX_HOST=homelab.${DOMAIN}
PROXMOX_PORT=8006 #Used by : Molecule
PROXMOX_MAIN_NODE=node-3 #Used by : Molecule
DNS_ADDRESS=192.168.1.254
SSH_PUBLIC_KEY='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIKSM75OKaSg4wHcZeL4f/bpb9h3mhulxxmbPC4llqij quentin@nixos'
SSH_IDENTITY_FILE=${HOME}/.ssh/id_ed25519
PROJECT_PATH=${HOME}/Repos/homelab

PROXMOX_API=https://${PROXMOX_HOST}:${PROXMOX_PORT}/api2/json #Used by : Molecule
PROXMOX_API_STUB=https://${PROXMOX_HOST}:${PROXMOX_PORT} #Used by : Molecule

ADMIN_HOST=192.168.1.95:8080
NODE_PREFIX=node


# --------------------------- Podman ---------------------------

PODMAN_NODE_PREFIX=${NODE_PREFIX}
PODMAN_ADMIN_HOST=${ADMIN_HOST}

# --------------------------- Terraform ---------------------------

TERRAFORM_TOKEN_ID=terraform
TERRAFORM_USER=terraform-prov

TF_VAR_ssh_public_key_path=${SSH_PUBLIC_KEY}
TF_VAR_domain=${DOMAIN}
TF_VAR_proxmox_api=${PROXMOX_API_STUB}
TF_VAR_keyboard_layout=azerty
TF_VAR_language=french
TF_VAR_dns_address=${DNS_ADDRESS}
TF_VAR_homelab_vnet_dns="10.0.0.1"
TF_VAR_tf_modules_path=${PROJECT_PATH}/terraform_modules




# --------------------------- Ansible ---------------------------

ANSIBLE_ADMIN_HOST=${ADMIN_HOST}
ANSIBLE_NODE_PREFIX=${NODE_PREFIX}

ANSIBLE_ROLES_PATH="${PROJECT_PATH}/ansible_roles"
ANSIBLE_USER=ansible
ANSIBLE_SSH_PRIVATE_KEY_FILE=${SSH_PRIVATE_KEY_FILE}
ANSIBLE_SSH_PUBLIC_KEY=${SSH_PUBLIC_KEY}
ANSIBLE_ISCSI_PORTAL=192.168.1.132
ANSIBLE_ISCSI_IQN=iqn.2024-01

ANSIBLE_PROXMOX_API=${PROXMOX_API_STUB}
ANSIBLE_PROXMOX_TOKEN_ID=${TERRAFORM_TOKEN_ID}
ANSIBLE_USER_PVE=${TERRAFORM_USER}@pve

# --------------------------- Molecule ---------------------------

MOLECULE_PROXMOX_API=${PROXMOX_API}
MOLECULE_PROXMOX_HOST=${PROXMOX_HOST} #Used by : Molecule
MOLECULE_PROXMOX_USER=${TERRAFORM_USER}@pve #Used by : Molecule
MOLECULE_PROXMOX_TOKEN_ID=${TERRAFORM_TOKEN_ID} #Used by : Molecule
MOLECULE_PROXMOX_NODE=${PROXMOX_MAIN_NODE} #Used by : Molecule
MOLECULE_PROXMOX_TEMPLATE=template.vm.pve #Used by : Molecule
MOLECULE_PROXMOX_DNS=${DNS_ADDRESS}
MOLECULE_SSH_PUBLIC_KEY=${SSH_PUBLIC_KEY}
MOLECULE_SSH_IDENTITY_FILE=${SSH_IDENTITY_FILE}
MOLECULE_PROJECT_PATH=${PROJECT_PATH}

PROXMOX_VM=192.168.1.73

# --------------------------- PXE HTTP ---------------------------

PXE_HTTP_PORT=8080
PXE_HTTP_STATIC_DIR=/srv
PXE_HTTP_ANSWER_DIR=/answers
PXE_HTTP_NODE_PREFIX=${NODE_PREFIX}
PXE_HTTP_STATE_FILE=/data/nodes.json
PXE_HTTP_ADMIN_HOST=${ADMIN_HOST}
